# Names and placeholders only. Never commit real secrets.
# Provider API keys belong on the server (FastAPI), never in this client bundle.

# Base URL of the future Orizon Nimasa backend (not used by the demo mock API)
VITE_API_BASE_URL=http://127.0.0.1:8015/api/v1   # leave empty to use the built-in synthetic mock
# Optional: set to /api/v1 to call the API through the Vite dev proxy instead (no CORS needed). Target below.
# VITE_API_PROXY=http://127.0.0.1:8015

# Basemap tiles. Check the provider's tile-usage policy before launch.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
